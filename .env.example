# Local / GitHub Actions secrets — copy to .env or configure in repo Settings → Secrets
# Do NOT commit actual values.

# Translation API key (required for Chinese translation and dish explanations)
# Default config uses DeepSeek (https://api.deepseek.com); put your DeepSeek API key here.
OPENAI_API_KEY=sk-your-deepseek-api-key

# Resend API key (required for sending email)
RESEND_API_KEY=re_your-resend-api-key

# Non-sensitive settings: recipients, model, api_base, etc. → see config.yml
